@using VibeCode.Shared.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["AccessDenied_Title"];
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: 75vh;">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0" style="border-radius: 16px; overflow: hidden; background: var(--color-white);">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <i class="bi bi-shield-lock-fill text-danger" style="font-size: 4.5rem; filter: var(--drop-shadow);"></i>
                    </div>
                    
                    <h1 class="display-5 fw-bold mb-3" style="color: var(--color-dark);">@Localizer["AccessDenied_Heading"]</h1>
                    
                    <p class="lead mb-4 text-secondary" style="font-size: 1.15rem; font-weight: 400;">
                        @Localizer["AccessDenied_Message"]
                    </p>
                    
                    @if (!string.IsNullOrWhiteSpace(returnUrl))
                    {
                        <div class="alert alert-light border mb-4 text-start p-3" style="border-radius: var(--border-radius); font-size: 0.95rem; background-color: var(--color-light);">
                            <span class="fw-semibold text-dark d-block mb-1">@Localizer["AccessDenied_UrlLabel"]</span>
                            <code class="text-break text-danger">@returnUrl</code>
                        </div>
                    }
                    
                    <hr class="my-4 text-muted opacity-25">
                    
                    <div class="d-flex justify-content-center gap-3">
                        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg px-4" style="border-radius: var(--border-radius); font-size: 1rem;">
                            <i class="bi bi-arrow-left me-2"></i>@Localizer["Button_GoBack"]
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4" style="background: var(--color-primary); border: none; border-radius: var(--border-radius); font-size: 1rem;">
                            <i class="bi bi-house-door me-2"></i>@Localizer["Button_Home"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
