@using VibeCode.Shared.Entities.Auth
@using System.Security.Claims
@using VibeCode.Shared.Constants
@inject VibeCode.IdentityServer.Services.Interface.IPermissionService PermissionService

@{
    ViewData["Title"] = "VibeCode.IdentityServer";

    // 1. Extract permissions from claims (stored in the Auth cookie/token)
    var userPermissions = User.Claims
        .Where(c => c.Type == AppConstants.Permission)
        .Select(c => c.Value);

    // 2. Get the pruned menu tree
    var menuTree = await PermissionService.GetVisibleMenusAsync(userPermissions);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VibeCode.IdentityServer.styles.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark top-navbar">
        <div class="container-fluid">
            @if (ViewData["ShowSidebar"] as bool? != false)
            {
                <button class="btn btn-dark me-2" type="button" id="sidebarToggle">
                    <span class="navbar-toggler-icon"></span>
                </button>
            }
            <ul class="navbar-nav ms-auto">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="~/images/default-avatar.svg" alt="Avatar" width="32" height="32" class="rounded-circle avatar-circle">
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
            </ul>
        </div>
    </nav>

    @if (ViewData["ShowSidebar"] as bool? != false)
    {
        <div class="sidebar" id="sidebar">
            <button class="sidebar-close d-lg-none" type="button" id="sidebarClose">
                <i class="bi bi-x-lg"></i>
            </button>

            <div class="pt-3">
                @* Static Home Link *@
                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door me-2"></i>Home
                </a>

                @* --- DYNAMIC MENU START --- *@
                @foreach (var parent in menuTree)
                {
                    @* Parent acts as a Section Header *@
                    <div class="sidebar-section-label px-3 pt-4 pb-1 text-uppercase small fw-bold text-muted">
                        @parent.Name
                    </div>

                    @foreach (var child in parent.Children)
                    {
                        @* Since URL is already prefixed with /auth or /main, we use href directly *@
                        <a href="@child.Url" class="@(Context.Request.Path.StartsWithSegments(child.Url) ? "active" : "")">
                            @if (!string.IsNullOrEmpty(child.Icon))
                            {
                                <i class="@child.Icon me-2"></i>
                            }
                            else
                            {
                                <i class="bi bi-circle me-2" style="font-size: 0.5rem;"></i>
                            }
                            @child.Name
                        </a>
                    }
                }
                @* --- DYNAMIC MENU END --- *@
            </div>
        </div>
    }

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="main-content" id="mainContent" style="@((ViewData["ShowSidebar"] as bool? == false ? "margin-left: 0;" : ""))">
        <main role="main" class="p-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js" defer></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>