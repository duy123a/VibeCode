@inject IStringLocalizer<SharedResources> Localizer
@using VibeCode.Shared.Resources
@using Microsoft.Extensions.Localization

@model ErrorViewModel
@{
    ViewData["Title"] = $"Error {Model.StatusCode}";

    var iconClass = "bi-exclamation-triangle-fill text-danger";
    var badgeBg = "bg-danger-subtle text-danger";

    if (Model.StatusCode == 404)
    {
        iconClass = "bi-question-circle-fill text-warning";
        badgeBg = "bg-warning-subtle text-warning";
    }
    else if (Model.StatusCode == 403 || Model.StatusCode == 401)
    {
        iconClass = "bi-shield-lock-fill text-danger";
        badgeBg = "bg-danger-subtle text-danger";
    }
}

<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: 75vh;">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0" style="border-radius: 16px; overflow: hidden; background: var(--color-white);">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <i class="bi @iconClass" style="font-size: 4.5rem; filter: var(--drop-shadow);"></i>
                    </div>

                    <span class="badge rounded-pill px-3 py-2 mb-3 fw-semibold @badgeBg" style="font-size: 1rem; border: 1px solid currentColor;">
                        Status Code: @Model.StatusCode
                    </span>

                    <h1 class="display-5 fw-bold mb-3" style="color: var(--color-dark);">@Localizer["Error_Title"]</h1>

                    <p class="lead mb-4 text-secondary" style="font-size: 1.15rem; font-weight: 400;">
                        @Model.Message
                    </p>

                    <hr class="my-4 text-muted opacity-25">

                    <div class="d-flex justify-content-center gap-3">
                        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg px-4" style="border-radius: var(--border-radius); font-size: 1rem;">
                            <i class="bi bi-arrow-left me-2"></i>@Localizer["Button_GoBack"]
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4" style="background: var(--color-primary); border: none; border-radius: var(--border-radius); font-size: 1rem;">
                            <i class="bi bi-house-door me-2"></i>@Localizer["Back_To_Home"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

