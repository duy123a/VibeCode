<div class="bg-white rounded-4 shadow p-4 account-form-wrapper">
    <h2 class="text-bg-login fw-bold mb-2">@Localizer["Login_As_Admin"]</h2>

    <form asp-action="Login" method="post" onsubmit="showLoading()">
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Email" class="control-label text-bg-login"></label>
            <input asp-for="Email" class="form-control" type="text" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password" class="control-label text-bg-login"></label>
            <div class="input-group">
                <input asp-for="Password" id="PasswordInput" class="form-control" />
                <button type="button" class="btn btn-outline-secondary" onclick="togglePasswordVisibility('PasswordInput')">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label text-bg-login"></label>
        </div>

        <br />
        <button type="submit" class="btn btn-asaka-submit">@Localizer["Button_Login_Submit"]</button>
    </form>
</div>
